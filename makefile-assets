GAMES = sf2 mk2 sfvsmk2
BASE_URL = https://storage.googleapis.com/google-code-archive-downloads/v2/code.google.com/java-fighting-game-engine

.PHONY: get_assets clean

get_assets: $(GAMES:%=download_%) $(GAMES:%=unzip_%)

download_%:
	@echo "Downloading $(BASE_URL)/$*_images_0.1.zip"
	curl -s -o $*.zip $(BASE_URL)/$*_images_0.1.zip

unzip_%:
	mkdir -p $*/assets
	unzip -o -q $*.zip -d $*/assets

clean:
	find mk2 sf2 sfvsmk2 -type f ! -name '.gitkeep' -path '*/assets/*' -delete 2>/dev/null || true
	find mk2 sf2 sfvsmk2 -type d -empty -path '*/assets/*' -delete 2>/dev/null || true
	rm -f $(GAMES:%=%.zip)
	rm -f $(GAMES:%=%.jar)

